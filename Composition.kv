#:import RESOURCES resources.RESOURCES  

<MenuButton@Button>
    font_size: "40dp"
    font_name: "assets/CascadiaCode.ttf"


<MainLabel@Label>
    color: "black"
    font_name: "assets/CascadiaCode.ttf"
    canvas.before:
        Color:
            rgba:(0.6, 0.7, 0.85, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]


<MainImage@Image>   
    size_hint: (0.1, 0.1)
    fit_mode: 'contain'
    size_hint_x: 0.4
    pos_hint: {'center_y': 0.5}
    size_hint_y: None
    height: dp(50)


<BoxRow@BoxLayout>:
    size_hint_y: None
    height: dp(50)


<MenuScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: 80
        Label:
            text: "Склад"
            font_size: "40sp"
            color: (0.15, 0.15, 0.15, 1)
            font_name: "assets/CascadiaCode.ttf"
            canvas.before:
                Color:
                    rgba: (0.85, 0.87, 0.90, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]
        Image:
            source: 'assets/images/logo.png'
            fit_mode: 'cover'
        MenuButton:
            text: "Открыть"
            on_press: root.goto_main()
            
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            canvas.before:
                Color:
                    rgba: (0.11, 0.31, 0.85, 1) if self.state == 'normal' else (0.15, 0.39, 0.92, 1)   

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]


<MainScreen>:
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        GridLayout:
            id: main_container
            cols: 1
            row_default_height: 40
            padding: '20dp'
            spacing: '6dp'